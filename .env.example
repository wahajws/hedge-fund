NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGIN=http://127.0.0.1:5173

AUTH_REQUIRED=false
JWT_SECRET=replace-me
INTERNAL_SERVICE_TOKEN=replace-me
AUDIT_HASH_SECRET=replace-me

USE_MOCK_PROVIDERS=false
FRED_API_KEY=replace-me
ALPHA_VANTAGE_API_KEY=replace-me
FMP_API_KEY=replace-me

QWEN_API_KEY=replace-me
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_TIMEOUT=30000
QWEN_MAX_RETRIES=2

DATABASE_URL=
REDIS_URL=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
WEBSOCKET_HEARTBEAT_MS=30000

# Local frontend defaults. Do not set these to loopback values in Vercel.
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_WS_URL=ws://127.0.0.1:4000/ws
